# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data & results (never commit large files).
# results/* rather than results/ so the checked-in guide below can be
# re-included; a whole-directory exclusion cannot be negated per-file.
data/
results/*
!results/README.md
logs/
checkpoints/
*.pt
*.nc
*.pkl
*.h5

# Papers & references
papers/
*.pdf

# Downloaded reference material (journal HTML/TXT; mostly anti-bot 404 pages)
refs/

# OS artifacts
.DS_Store
Thumbs.db
nul

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Misc
*.log
.env

# Dashboard (secrets must never be committed)
dashboard/secret.json
dashboard/node_modules/
dashboard/curve_cache/

# Deep-heat campaign scratch artifacts (2026-09 ~ 09-13). The scripts were
# removed in the 2026-09-19 cleanup; these patterns catch leftover outputs.
_*.out
_*.err
_*.tgz
_*.xlsx
_*.txt
_*.png
_*.b64
_ana_tmp/
runs_gm5d/
_publish_loop.*
init_fields_*.npz
_blowup_snapshot.npz
.plans/

# Session scratch (convention: a leading underscore at repo root means scratch).
# Root-anchored so dunders like src/__init__.py are never accidentally matched.
/_*.py
/_*.sh
/_*.json
/_*.csv
/_*.npz
/_*.pptx
*.pptx
